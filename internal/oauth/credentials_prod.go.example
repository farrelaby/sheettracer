//go:build production

package oauth

// Copy this file to credentials_prod.go (same directory) and fill in the real
// values, then build with `wails3 task build` (the template pipeline passes
// -tags production automatically). credentials_prod.go is gitignored so the
// secret never enters version control; CI generates it from GitHub Secrets.
var (
	DefaultClientID     = "REPLACE_WITH_CLIENT_ID.apps.googleusercontent.com"
	DefaultClientSecret = "REPLACE_WITH_CLIENT_SECRET"
)
